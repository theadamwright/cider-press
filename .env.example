# Copy to .env and fill in. .env is gitignored.
#
#   cp .env.example .env
#
# Or skip the file entirely and just export the token in your shell:
#
#   export EDB_SUBSCRIPTION_TOKEN="..."

# ---------------------------------------------------------------------------
# Required for `cider build` only. Get one at:
#   https://www.enterprisedb.com/repos-downloads
# It is passed to the build as a BuildKit secret and never written into the
# image, so it does not survive in any layer or in the build history.
# ---------------------------------------------------------------------------
EDB_SUBSCRIPTION_TOKEN=

# ---------------------------------------------------------------------------
# Topology
# ---------------------------------------------------------------------------
#CIDER_NODES=3
#CIDER_CLUSTER_NAME=cider
#CIDER_GROUP_NAME=group-1

# DNS domain Apple container appends to container names. Nodes address each
# other as host-1.$CIDER_DOMAIN, so changing this means re-running
# `cider bootstrap`. If your Mac already uses a container DNS domain (commonly
# "test"), set that here instead of adding a second one.
#CIDER_DOMAIN=cider

# ---------------------------------------------------------------------------
# Naming. Container names are what container's DNS registers, so host_prefix
# feeds directly into the <host>.<domain> names the nodes dial each other on.
# ---------------------------------------------------------------------------
#CIDER_IMAGE=cider-press:latest
#CIDER_HOST_PREFIX=host-
#CIDER_NODE_PREFIX=node-
#CIDER_VOLUME_PREFIX=cider-press-

# ---------------------------------------------------------------------------
# Postgres / PGD
#   Only pge has been built and run. epas and pg are implemented and their
#   packages exist for Debian 12 arm64, but are unverified.
#
#   PG_FLAVOR=pge   EDB Postgres Extended     (default, verified)
#   PG_FLAVOR=epas  EDB Postgres Advanced Server (unverified; CIDER_USER
#                   defaults to enterprisedb automatically)
#   PG_FLAVOR=pg    community PostgreSQL (unverified)
# ---------------------------------------------------------------------------
#PG_FLAVOR=pge
#PG_MAJOR=18
#DEBIAN_VERSION=12

# ---------------------------------------------------------------------------
# Database. CIDER_USER / CIDER_PASSWORD are also the PGD Monitor web UI login.
# ---------------------------------------------------------------------------
#CIDER_DB=pgddb
#CIDER_USER=postgres      # default follows PG_FLAVOR
#CIDER_PASSWORD=secret

# ---------------------------------------------------------------------------
# Preload pg_stat_statements and create the extension. Powers the web UI's
# Query Diagnostics page. cider adds it to shared_preload_libraries alongside
# PGD's own entry, then verifies the node still starts and rolls the change
# back if it does not. Set to "off" to leave shared_preload_libraries alone.
# ---------------------------------------------------------------------------
#CIDER_STAT_STATEMENTS=on

# ---------------------------------------------------------------------------
# Connection Manager pooling (server_pool_mode group option).
#   session      a backend is held for the life of a client connection, then
#                returned to the pool with DISCARD ALL. No application-visible
#                caveats. cider's default.
#   transaction  a backend is held only for a transaction. Higher throughput,
#                but no session SET, LISTEN, temp tables or advisory locks
#                across transactions.
#   none         PGD's own default: no pooling at all.
#   leave        do not touch whatever the cluster already has.
# ---------------------------------------------------------------------------
#CIDER_POOL_MODE=session

# ---------------------------------------------------------------------------
# PGD Monitor — the built-in web UI, REST API and Prometheus endpoint added in
# PGD 6.5.0. PGD ships it off (bdr.monitor_enabled defaults to false); cider
# turns it on. Set to "off" to keep stock behaviour.
# ---------------------------------------------------------------------------
#CIDER_MONITOR=on

# ---------------------------------------------------------------------------
# Resources per node, and build
# ---------------------------------------------------------------------------
#CIDER_CPUS=2
#CIDER_MEMORY=2G
#CIDER_BUILD_CPUS=4
#CIDER_BUILD_MEMORY=4G

# How long `cider up` waits for a node to come up and join.
#CIDER_READY_TIMEOUT=420

# ---------------------------------------------------------------------------
# Published loopback ports. Node i gets:
#   direct postgres  CIDER_PG_PORT_BASE + (i-1)
#   cm read-write    CIDER_CM_PORT_BASE + (i-1)*10
#   cm read-only     ... + 1
#   cm http status   ... + 2
# ---------------------------------------------------------------------------
#CIDER_PG_PORT_BASE=5432
#CIDER_CM_PORT_BASE=6432
